# syntax=docker/dockerfile:1
# Builder runs on the host architecture (BUILDPLATFORM) and cross-compiles
# the Go binary to the target architecture (TARGETARCH) buildx requested.
# This is the canonical multi-arch buildx pattern — gives us a single-stage
# native compile per target without QEMU emulating the entire build.
FROM --platform=$BUILDPLATFORM golang:1.26-alpine AS builder

# Defaults so plain `docker build` (no buildx) still works — buildx
# overrides these from --platform for multi-arch CI builds.
ARG TARGETOS=linux
ARG TARGETARCH=amd64

WORKDIR /src

COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download

COPY . .
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
        go build -a -o /inventory ./cmd/inventory

FROM alpine:3.23

# hadolint ignore=DL3018
RUN apk add --no-cache ca-certificates \
    && addgroup -S -g 10001 app \
    && adduser -S -u 10001 -G app app

USER 10001

COPY --from=builder /inventory /inventory

EXPOSE 3000 3002

ENTRYPOINT ["/inventory"]
