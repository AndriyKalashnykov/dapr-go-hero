# Environment configuration for dapr-go-hero.
# Loaded by godotenv on startup. Existing env vars take precedence.
# Regenerate with: make generate-env

# Inventory service
PUBLIC_API_ADDR=:3000
CUSTOM_HTTP_ADDR=:3001
CUSTOM_GRPC_ADDR=0.0.0.0:4001
SDK_HTTP_ADDR=:3002
SDK_GRPC_ADDR=:4002

# Products service
PRODUCTS_ADDR=0.0.0.0:50151

# Dapr sidecar (set automatically by dapr run / K8s sidecar injector)
DAPR_HTTP_PORT=3500
DAPR_GRPC_PORT=50001
